{
  "id": "/",
  "name": "Plumb — Your money, in perspective",
  "short_name": "Plumb",
  "description": "A private, local-first personal budget.",
  "lang": "en-IN",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#081513",
  "theme_color": "#081513",
  "categories": ["finance", "productivity"],
  "icons": [
    {
      "src": "/icons/plumb-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/plumb-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/plumb-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/plumb-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add expense",
      "short_name": "Add expense",
      "url": "/?action=add-expense",
      "icons": [{ "src": "/icons/plumb-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "View transactions",
      "short_name": "Transactions",
      "url": "/?page=transactions",
      "icons": [{ "src": "/icons/plumb-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
